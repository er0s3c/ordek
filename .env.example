# ördek-lab ortam değişkenleri — `npm run setup` bu dosyanın gerçeğini (.env) üretir.
# Bu örneği elle .env'e kopyalayabilirsin de.

# Kurulum modu: individual (bireysel) | class (sınıf)
LAB_MODE=individual

# Panel oturum çerezini imzalayan gizli anahtar (sınıf modu için önemli).
# setup.mjs rastgele üretir. Elle ayarlıyorsan uzun ve rastgele bir değer kullan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LAB_SESSION_SECRET=

# (Opsiyonel) Makine imajı etiketi — docker-compose ile aynı olmalı.
# MACHINE_IMAGE=ordek-lab:latest

# Gerçek araç labı dağıtım modu (otomatik · Windows + VirtualBox/VMware dostu):
#   bridge  → VARSAYILAN. Hedef servis portları host'a otomatik yayımlanır; öğrenci KENDİ
#             Kali VM'inden Windows host IP'sine bağlanır. macvlan/LAN ayarı GEREKMEZ.
#   macvlan → gerçek Linux host + fiziksel LAN (LAB_LAN_* dolu olmalı; aksi halde bridge'e düşer).
#   test    → gömülü Kali saldırgan kutusu (ttyd/noVNC) — yalnız proje testleri.
# LAB_ATTACKER_MODE=bridge
# LAB_BRIDGE_BIND=0.0.0.0          # yayımlanan portların bağlanacağı host IP'si
# LAB_BRIDGE_FIXED_PORTS=1         # sabit standart portları dene (1) / hep dinamik (0)
# macvlan modu için (yalnızca LAB_ATTACKER_MODE=macvlan):
# LAB_LAN_SUBNET=192.168.1.0/24
# LAB_LAN_GATEWAY=192.168.1.1
# LAB_LAN_PARENT=eth0
# LAB_LAN_IPRANGE=192.168.1.200/29

# (Opsiyonel) Akademi görsel üretimi için Gemini API anahtarı.
# `npm run academy:images` bunu kullanır. NOT: Gemini 3 Pro Image (gemini-3-pro-image-preview)
# ücretsiz katmanda ÇALIŞMAZ (free_tier_requests limit=0) — faturalandırma/ödeme gerekir.
# GEMINI_API_KEY=
