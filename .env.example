# ördek-lab ortam değişkenleri — `npm run setup` bu dosyanın gerçeğini (.env) üretir.
# Bu örneği elle .env'e kopyalayabilirsin de.

# Kurulum modu: individual (bireysel) | class (sınıf)
LAB_MODE=individual

# Panel oturum çerezini imzalayan gizli anahtar (sınıf modu için önemli).
# setup.mjs rastgele üretir. Elle ayarlıyorsan uzun ve rastgele bir değer kullan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LAB_SESSION_SECRET=

# (Opsiyonel) Makine imajı etiketi — docker-compose ile aynı olmalı.
# MACHINE_IMAGE=ordek-lab:latest
